# ═══════════════════════════════════════════════════════════════
# SKYLUX Airways — Environment Variables
# Copy this to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/skylux

# ── Authentication ──
JWT_SECRET=your-secure-secret-here-change-in-production

# ── Email (Nodemailer SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@skyluxairways.com

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
# REAL API INTEGRATIONS
# ═══════════════════════════════════════════════════════════════

# ── Duffel (Real Flight Search & Booking — 300+ airlines) ──
# Sign up: https://app.duffel.com/join
# Free test mode available — no credit card needed
# Docs: https://duffel.com/docs/api
DUFFEL_API_TOKEN=

# ── AviationStack (Live Flight Tracking) ──
# Get API key: https://aviationstack.com/signup/free
# Free tier: 100 requests/month
AVIATIONSTACK_API_KEY=

# ── Stripe (Payment Processing) ──
# Get credentials: https://dashboard.stripe.com/apikeys
# Use test keys for development (prefix: sk_test_)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=     # From: stripe listen --forward-to localhost:3000/api/payments/webhook
